SECRET_KEY=your-long-random-secret-key-here
DATABASE_URL=sqlite:///./sports_analytics.db
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...
FRONTEND_URL=http://localhost:5173

# Admin API (app/routers/admin.py) -- required header: X-Admin-Key.
# Leave unset to keep those routes disabled entirely.
ADMIN_API_KEY=pick-a-long-random-string

# Outbound email (app/notifications.py) -- powers the "new user" ping and
# the admin API's /test-email route. Leave SMTP_USER/PASSWORD or
# ADMIN_NOTIFY_EMAIL unset to leave notifications off; nothing else depends
# on this being configured.
#
# Fastest path with an existing Gmail account: Google Account -> Security ->
# 2-Step Verification -> App Passwords -> generate one for "Mail", and use
# that (not your normal password) as SMTP_PASSWORD.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM=you@gmail.com
ADMIN_NOTIFY_EMAIL=you@gmail.com
